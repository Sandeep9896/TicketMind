{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install frontend dependencies",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "inAgents": true,
      "runOptions": {
        "runOn": "worktreeCreated"
      },
      "problemMatcher": []
    },
    {
      "label": "Install backend dependencies",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "inAgents": true,
      "runOptions": {
        "runOn": "worktreeCreated"
      },
      "problemMatcher": []
    },
    {
      "label": "Start frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "inAgents": true,
      "problemMatcher": {
        "owner": "vite",
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*"
        },
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1,
          "location": 1,
          "message": 2
        }
      }
    },
    {
      "label": "Start backend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "inAgents": true,
      "problemMatcher": {
        "owner": "nodemon",
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*"
        },
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1,
          "location": 1,
          "message": 2
        }
      }
    }
  ]
}
